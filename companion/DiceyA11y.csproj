<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('OSX'))">net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DiceyA11y</AssemblyName>
    <RootNamespace>DiceyA11y</RootNamespace>
    <!-- The release workflow refuses a tag that does not match this. -->
    <Version>1.2.4</Version>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      Self-contained, so players need no .NET runtime installed (a missing runtime meant a
      silent game). Single file keeps the folder down to DiceyA11y.exe and prism.dll.
    -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The Mac key tap passes a function pointer to native code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Prism ships x64 Windows binaries only; the game is x64 too. -->
  </PropertyGroup>

  <!--
    macOS: the companion runs natively (the game itself is x86_64 under Rosetta; the two
    only share a socket). Mac/package_mac.sh wraps the published output in an app bundle.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- package_mac.sh lays the published files out inside an app bundle. -->
    <PublishSingleFile>false</PublishSingleFile>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == 'win-x64' OR '$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="Mac\bin\libDiceyMac.dylib" Condition="Exists('Mac\bin\libDiceyMac.dylib')">
      <Link>libDiceyMac.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The mod's own words in every language but English and Spanish (Core/Strings.cs loads them). -->
  <ItemGroup>
    <EmbeddedResource Include="Locale\*.json" LogicalName="Locale.%(Filename).json" />
  </ItemGroup>

  <!--
    prism.dll is a NATIVE library. It is copied next to the built exe and loaded
    explicitly by full path (see Speech/PrismNative.Load) because the exe's own
    directory is not always on the DLL search path when launched via Steam.
  -->
  <ItemGroup>
    <None Include="$(PrismDir)\dynamic\release\bin\prism.dll"
          Condition="'$(PrismDir)' != '' AND Exists('$(PrismDir)\dynamic\release\bin\prism.dll')">
      <Link>prism.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="C:\Users\Nitropc\code\libs\prism\prism-windows-x64\dynamic\release\bin\prism.dll"
          Condition="'$(PrismDir)' == '' AND Exists('C:\Users\Nitropc\code\libs\prism\prism-windows-x64\dynamic\release\bin\prism.dll')">
      <Link>prism.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
