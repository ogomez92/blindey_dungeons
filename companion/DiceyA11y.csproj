<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DiceyA11y</AssemblyName>
    <RootNamespace>DiceyA11y</RootNamespace>
    <!-- The release workflow refuses a tag that does not match this. -->
    <Version>1.1.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Prism ships x64 Windows binaries only; the game is x64 too. -->
  </PropertyGroup>

  <!--
    prism.dll is a NATIVE library. It is copied next to the built exe and loaded
    explicitly by full path (see Speech/PrismNative.Load) because the exe's own
    directory is not always on the DLL search path when launched via Steam.
  -->
  <ItemGroup>
    <None Include="$(PrismDir)\dynamic\release\bin\prism.dll"
          Condition="'$(PrismDir)' != '' AND Exists('$(PrismDir)\dynamic\release\bin\prism.dll')">
      <Link>prism.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="C:\Users\Nitropc\code\libs\prism\prism-windows-x64\dynamic\release\bin\prism.dll"
          Condition="'$(PrismDir)' == '' AND Exists('C:\Users\Nitropc\code\libs\prism\prism-windows-x64\dynamic\release\bin\prism.dll')">
      <Link>prism.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
